{
  "name": "didibhaiyakibiryani-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Didi Bhaiya ki Biryani — full restaurant management platform (website, customer app, admin, server).",
  "scripts": {
    "dev:website": "npm --prefix website run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:mobile": "npm --prefix mobile-app run start",
    "all": "concurrently -k -n website,server,admin,mobile -c blue,green,magenta,yellow \"npm:dev:website\" \"npm:dev:server\" \"npm:dev:admin\" \"npm:dev:mobile\"",
    "build:website": "npm --prefix website run build",
    "build:server": "npm --prefix server run build",
    "build:admin": "npm --prefix admin run build",
    "seed": "npm --prefix server run seed",
    "install:server": "npm --prefix server install",
    "install:admin": "npm --prefix admin install",
    "install:mobile": "npm --prefix mobile-app install",
    "install:all": "npm run install:server && npm run install:admin && npm run install:mobile"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
