---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  active?: string;
  ogImage?: string;
}

const {
  title = "Didi Bhaiya ki Biryani — 100% Veg Dum Biryani",
  description = "100% vegetarian dum biryani, slow-cooked in copper handis with hand-ground spice and delivered piping hot in 35 minutes. Har bite, yaad rahe.",
  active = "",
  ogImage = "/biryani-1.jpg",
} = Astro.props;

const site = Astro.site ?? new URL("https://didibhaiyakibiryani.com");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Structured data for rich results + Generative Engine Optimization (GEO):
// Restaurant + Organization + WebSite so AI search and Google understand the brand.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Restaurant",
      "@id": `${site.href}#restaurant`,
      name: "Didi Bhaiya ki Biryani",
      description,
      url: site.href,
      image: ogImageUrl,
      servesCuisine: ["Indian", "Biryani", "Vegetarian"],
      priceRange: "₹₹",
      acceptsReservations: false,
      hasMenu: `${site.href}#menu`,
      areaServed: "India",
      slogan: "Har bite, yaad rahe!",
    },
    {
      "@type": "Organization",
      "@id": `${site.href}#org`,
      name: "Didi Bhaiya ki Biryani",
      url: site.href,
      logo: new URL("/didibhaiyakibiryani-logo.png", site).href,
    },
    {
      "@type": "WebSite",
      "@id": `${site.href}#website`,
      url: site.href,
      name: "Didi Bhaiya ki Biryani",
      inLanguage: "en-IN",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Didi Bhaiya ki Biryani" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0b0705" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/didibhaiyakibiryani-logo.png" />
    <link id="dynamic-favicon" rel="icon" href="/didibhaiyakibiryani-logo.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600;1,700&family=Mulish:wght@400;500;600;700;800&family=Dancing+Script:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Toast for copied coupon codes -->
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <style>
      .toast {
        position: fixed;
        left: 50%;
        bottom: 28px;
        transform: translateX(-50%) translateY(40px);
        background: linear-gradient(180deg, #f0c768, #d49a3c);
        color: #2a1a06;
        font-weight: 800;
        padding: 13px 24px;
        border-radius: 999px;
        box-shadow: 0 18px 46px -10px rgba(0, 0, 0, 0.6);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
        z-index: 200;
        font-size: 0.95rem;
      }
      .toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    </style>

    <script>
      // Reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Copy-to-clipboard for coupon codes + toast
      const toast = document.getElementById("toast");
      let toastTimer: number | undefined;
      function showToast(msg: string) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add("show");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove("show"), 2200);
      }

      document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const code = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            /* clipboard may be blocked; still show feedback */
          }
          showToast(`Copied “${code}” — paste it at checkout!`);
        });
      });

      // Mobile nav toggle
      const navToggle = document.getElementById("nav-toggle");
      const nav = document.getElementById("site-nav");
      navToggle?.addEventListener("click", () => {
        nav?.classList.toggle("open");
        navToggle.classList.toggle("open");
      });

      // Admin-managed branding: apply primary color + company details live.
      const API =
        (import.meta.env.PUBLIC_API_URL as string) ||
        "https://server.didibhaiyakibiryani.com/graphql";
      fetch(API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          query:
            "query { settings { brandName tagline primaryColor logoUrl websiteHeaderLogoUrl websiteFooterLogoUrl faviconUrl companyAddress companyPhone companyEmail supportPhone supportEmail } }",
        }),
      })
        .then((r) => r.json())
        .then(({ data }) => {
          const s = data?.settings;
          if (!s) return;
          if (s.primaryColor) {
            document.documentElement.style.setProperty("--gold", s.primaryColor);
          }
          // ImageKit size transform helper (no-op for non-ImageKit URLs).
          const sized = (url: string, w: number) =>
            url && url.includes("imagekit.io") ? `${url}?tr=w-${w}` : url;
          const favicon = s.faviconUrl || s.logoUrl;
          if (favicon) {
            const link = document.getElementById("dynamic-favicon") as HTMLLinkElement | null;
            if (link) link.href = sized(favicon, 64);
          }
          document.querySelectorAll<HTMLImageElement>("img[data-logo]").forEach((img) => {
            const slot = img.getAttribute("data-logo");
            const url =
              (slot === "footer" ? s.websiteFooterLogoUrl : s.websiteHeaderLogoUrl) || s.logoUrl;
            if (url) img.src = sized(url, slot === "footer" ? 200 : 120);
          });
          document.querySelectorAll<HTMLElement>("[data-setting]").forEach((el) => {
            const key = el.getAttribute("data-setting") || "";
            const value = (s as Record<string, string>)[key];
            if (value) {
              el.textContent = value;
              if (el instanceof HTMLAnchorElement) {
                if (key.toLowerCase().includes("phone")) el.href = `tel:${value}`;
                if (key.toLowerCase().includes("email")) el.href = `mailto:${value}`;
              }
              el.closest("[data-setting-row]")?.removeAttribute("hidden");
            }
          });
        })
        .catch(() => {
          /* branding falls back to the built-in defaults */
        });
    </script>
  </body>
</html>
