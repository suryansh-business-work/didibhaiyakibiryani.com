---
import Layout from "../layouts/Layout.astro";

const cards = [
  {
    big: "₹50 OFF",
    title: "Flat fifty, any order",
    text: "Get ₹50 off on orders above ₹299. Stack it with a combo and thank us later.",
    code: "BIRYANI50",
    action: "copy" as const,
  },
  {
    big: "₹75 OFF",
    title: "Feast a little harder",
    text: "Ordering big? Take ₹75 off on orders above ₹499. Perfect for a duo or family combo.",
    code: "HARBITE",
    action: "copy" as const,
  },
  {
    big: "icon-phone",
    title: "App-only: free dessert",
    text: "Order from the app and add a free Gulab Jamun (2 pc) to any biryani. Sweeten the deal.",
    note: "Auto-applied in app",
    action: "app" as const,
  },
  {
    big: "FREE",
    title: "Free delivery over ₹399",
    text: "No code needed — every order above ₹399 ships free, all day, every day.",
    note: "No code needed",
    action: "order" as const,
  },
];
---

<Layout active="offers" title="Offers — Didi Bhaiya ki Biryani" description="Today's deals: 20% off your first biryani, flat ₹50 & ₹75 off, free dessert in the app and free delivery over ₹399.">
  <!-- ===== HERO ===== -->
  <section class="offers-hero">
    <div class="offers-hero__glow"></div>
    <div class="container offers-hero__inner reveal">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <span class="crumbs__current">Offers</span>
      </nav>
      <p class="eyebrow">Today's deals</p>
      <h1 class="offers-hero__title">
        More biryani,<br />less on the bill.
      </h1>
      <p class="offers-hero__sub">
        Tap a code to copy it, then paste it at checkout. Spots — and
        discounts — fill up fast. <span class="bolt">⚡</span>
      </p>
    </div>
  </section>

  <div class="container">
    <!-- ===== FEATURED ===== -->
    <div class="featured reveal">
      <div class="featured__main">
        <p class="featured__eyebrow">First order special</p>
        <h2 class="featured__title">
          <span class="featured__pct">20% OFF</span> your first biryani
        </h2>
        <p class="featured__text">
          New here? Welcome to the family. Get 20% off (up to ₹120) on your very
          first order — no minimum drama.
        </p>
      </div>
      <div class="featured__side">
        <span class="featured__code">FIRST20</span>
        <button class="btn btn-gold" data-copy="FIRST20">
          <svg class="icon" viewBox="0 0 24 24" width="16" height="16">
            <rect x="9" y="9" width="11" height="11" rx="2" />
            <path d="M5 15V5a2 2 0 0 1 2-2h10" />
          </svg>
          Copy code
        </button>
      </div>
    </div>

    <!-- ===== GRID ===== -->
    <div class="offers-grid">
      {
        cards.map((c) => (
          <article class="offer-card reveal">
            <div class="offer-card__top">
              {c.big === "icon-phone" ? (
                <span class="offer-card__icon">
                  <svg class="icon" viewBox="0 0 24 24" width="26" height="26">
                    <rect x="6" y="2" width="12" height="20" rx="3" />
                    <path d="M10 19h4" />
                  </svg>
                </span>
              ) : (
                <span class={`offer-card__big ${c.big === "FREE" ? "is-word" : ""}`}>{c.big}</span>
              )}
              <h3 class="offer-card__title">{c.title}</h3>
              <p class="offer-card__text">{c.text}</p>
            </div>

            <div class="offer-card__foot">
              {c.code ? (
                <span class="offer-card__code">{c.code}</span>
              ) : (
                <span class="offer-card__note">{c.note}</span>
              )}

              {c.action === "copy" && (
                <button class="offer-card__btn" data-copy={c.code}>
                  <svg class="icon" viewBox="0 0 24 24" width="15" height="15">
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                  </svg>
                  Copy
                </button>
              )}
              {c.action === "app" && (
                <a href="/#app" class="offer-card__btn">
                  <svg class="icon" viewBox="0 0 24 24" width="15" height="15">
                    <path d="M12 3v12M8 11l4 4 4-4" />
                    <path d="M5 21h14" />
                  </svg>
                  Get app
                </a>
              )}
              {c.action === "order" && (
                <a href="/offers" class="offer-card__btn">
                  <svg class="icon" viewBox="0 0 24 24" width="15" height="15">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                    <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
                  </svg>
                  Order
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <p class="fine-print reveal">
      Offers can't be clubbed unless stated. Valid on select cities. Didi Bhaiya
      ki Biryani reserves the right to modify or end offers anytime.
    </p>

    <!-- ===== CTA ===== -->
    <div class="offers-cta reveal">
      <p class="offers-cta__script">Code copied?</p>
      <h2 class="offers-cta__title">Go paste it at checkout.</h2>
      <a href="/offers" class="btn btn-gold">
        <svg class="icon" viewBox="0 0 24 24" width="18" height="18">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
          <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
        </svg>
        Start your order
      </a>
    </div>
  </div>
</Layout>

<style>
  .offers-hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-block: 56px 30px;
    background: radial-gradient(70% 80% at 50% 0%, rgba(74, 21, 21, 0.6), transparent 65%);
  }
  .offers-hero__glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(228, 182, 92, 0.12), transparent 65%);
    pointer-events: none;
  }
  .offers-hero__inner { position: relative; }
  .crumbs {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 18px;
  }
  .crumbs a { color: var(--text-dim); }
  .crumbs a:hover { color: var(--gold); }
  .crumbs span { margin-inline: 4px; }
  .crumbs__current { color: var(--text-muted); }

  .offers-hero__title {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1.04;
    margin-top: 12px;
  }
  .offers-hero__sub {
    color: var(--text-dim);
    max-width: 480px;
    margin: 22px auto 0;
    font-size: 1.02rem;
  }
  .bolt { color: #f0a93c; }

  /* Featured */
  .featured {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background:
      radial-gradient(120% 160% at 0% 0%, rgba(122, 36, 24, 0.95), #340f0f 65%);
    border: 1px solid rgba(232, 200, 140, 0.18);
    border-radius: var(--radius-lg);
    padding: 40px 44px;
    margin-top: 26px;
  }
  .featured__eyebrow {
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.72rem;
    font-weight: 800;
    color: #f0b86a;
    margin-bottom: 14px;
  }
  .featured__title {
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    line-height: 1.1;
  }
  .featured__pct { color: var(--gold); }
  .featured__text {
    color: #e7cdbf;
    max-width: 460px;
    margin-top: 12px;
    font-size: 0.96rem;
  }
  .featured__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
    flex: 0 0 auto;
  }
  .featured__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    letter-spacing: 3px;
    color: var(--gold);
  }

  /* Grid */
  .offers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 22px;
  }
  .offer-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .offer-card:hover {
    transform: translateY(-3px);
    border-color: var(--card-border-strong);
  }
  .offer-card__top { padding: 28px 28px 22px; }
  .offer-card__big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.4rem;
    color: var(--gold);
    line-height: 1;
    display: block;
    margin-bottom: 14px;
  }
  .offer-card__icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(228, 182, 92, 0.10);
    color: var(--gold);
    margin-bottom: 14px;
  }
  .offer-card__title { font-size: 1.2rem; margin-bottom: 8px; }
  .offer-card__text { color: var(--text-muted); font-size: 0.92rem; }

  .offer-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 28px;
    border-top: 1px dashed var(--card-border-strong);
  }
  .offer-card__code {
    font-family: var(--font-body);
    font-weight: 800;
    letter-spacing: 2px;
    color: var(--gold);
    font-size: 1.05rem;
  }
  .offer-card__note {
    color: var(--gold);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .offer-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(228, 182, 92, 0.12);
    border: 1px solid var(--gold-soft);
    color: var(--gold);
    font-weight: 700;
    font-size: 0.88rem;
    padding: 9px 16px;
    border-radius: 999px;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .offer-card__btn:hover { background: var(--gold); color: #2a1a06; }

  .fine-print {
    text-align: center;
    color: var(--text-faint);
    font-size: 0.82rem;
    max-width: 720px;
    margin: 34px auto 0;
  }

  /* CTA */
  .offers-cta {
    text-align: center;
    background:
      radial-gradient(90% 130% at 50% 0%, rgba(74, 21, 21, 0.55), transparent 70%),
      var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 56px 28px;
    margin: 60px 0 80px;
  }
  .offers-cta__script {
    font-family: var(--font-script);
    font-size: 1.5rem;
    color: var(--gold);
    margin-bottom: 4px;
  }
  .offers-cta__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 26px;
  }

  @media (max-width: 760px) {
    .featured { flex-direction: column; align-items: flex-start; }
    .featured__side { align-items: flex-start; width: 100%; }
    .offers-grid { grid-template-columns: 1fr; }
  }
</style>
