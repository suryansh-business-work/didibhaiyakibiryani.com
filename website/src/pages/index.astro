---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import AppBadges from "../components/AppBadges.astro";
import { iconSvg } from "../lib/icons";
import { API_URL, ORDER_URL } from "../lib/api";

const features = [
  {
    icon: "leaf",
    title: "100% Pure Veg",
    text: "A dedicated vegetarian kitchen. No cross-contact, ever.",
  },
  {
    icon: "pot",
    title: "Real Dum Cooking",
    text: "Sealed copper handis, slow heat, whole spices. The aroma does the talking.",
  },
  {
    icon: "clock",
    title: "Hot in 35 Minutes",
    text: "Cooked to order and rushed to your door in insulated packs, so it lands steaming.",
  },
  {
    icon: "heart",
    title: "Made with Pyaar",
    text: "Family recipes from Didi & Bhaiya's own kitchen. Har bite, yaad rahe.",
  },
];

const steps = [
  {
    n: "01",
    title: "Pick your biryani",
    text: "Browse veg biryanis, combos and sides. Filter by spice and craving.",
  },
  {
    n: "02",
    title: "Customise & checkout",
    text: "Set your spice level, add raita or dessert, choose address and pay — all in seconds.",
  },
  {
    n: "03",
    title: "Delivered piping hot",
    text: "Track your handi live. It arrives sealed, steaming and ready to make memories.",
  },
];

const reviews = [
  {
    text: "Finally a veg biryani that doesn't feel like a compromise. The paneer tikka one is unreal.",
    name: "Ananya S.",
    meta: "Indiranagar",
  },
  {
    text: "Ordered for 40 people at the office. On time, hot, and everyone asked where it was from.",
    name: "Karan M.",
    meta: "Office party",
  },
  {
    text: "The kathal biryani tastes just like my naani's. Har bite genuinely yaad reh gaya.",
    name: "Sneha P.",
    meta: "HSR Layout",
  },
];

const partyPerks = [
  { icon: "users", title: "10 – 500+ plates", text: "Scaled to any gathering" },
  { icon: "tag", title: "Up to 22% off", text: "Bulk per-plate pricing" },
  { icon: "headset", title: "Dedicated host", text: "One contact, zero stress" },
];
---

<Layout active="home">
  <Hero />
  <Marquee />

  <!-- ============ WHY ============ -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">Why Didi Bhaiya</p>
        <h2 class="section-title">
          Biryani done the <span class="italic-accent">slow,<br />right way.</span>
        </h2>
        <p class="section-sub">
          No shortcuts, no compromises. Just honest vegetarian biryani made the
          way it's made at home — only better, and delivered to you.
        </p>
      </div>

      <div class="feature-grid">
        {
          features.map((f) => (
            <div class="feature card reveal">
              <span class="feature__icon">
                <Fragment set:html={iconSvg(f.icon)} />
              </span>
              <h3 class="feature__title">{f.title}</h3>
              <p class="feature__text">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ MENU ============ -->
  <section class="section section--alt" id="menu">
    <div class="container">
      <div class="menu-head reveal">
        <div>
          <p class="eyebrow">Crowd favourites</p>
          <h2 class="section-title">
            The ones everyone <span class="italic-accent">orders twice.</span>
          </h2>
        </div>
        <div class="menu-head__side">
          <span class="store-status" id="store-status" hidden></span>
          <a href={ORDER_URL} class="link-arrow">Order on the app
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      <div class="menu-grid" id="menu-grid">
        <p class="menu-empty" id="menu-status">Loading our menu…</p>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ apiUrl: API_URL, orderUrl: ORDER_URL }}>
    (function () {
      const grid = document.getElementById("menu-grid");
      const QUERY =
        "query { menuItems { name description price spiceLevel serves badge isAvailable image } }";
      const PHOTOS = ["/biryani-1.jpg", "/biryani-2.jpg", "/biryani-3.jpg", "/biryani-4.jpg"];
      const photoFor = (m, i) => {
        const raw = m.image || PHOTOS[i % PHOTOS.length];
        return raw.includes("imagekit.io") ? raw + "?tr=w-520,h-330,fo-auto" : raw;
      };
      const esc = (v) =>
        String(v == null ? "" : v).replace(/[&<>"]/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]
        );
      function card(m, i) {
        const soldOut = m.isAvailable === false;
        const promoBadge = m.badge === "BESTSELLER" || m.badge === "NEW" ? m.badge : "";
        const hue = (i * 9 + 12) % 40;
        const spice = m.spiceLevel > 0 ? "🌶️".repeat(m.spiceLevel) : "";
        let badgeHtml = "";
        if (soldOut) {
          badgeHtml = '<span class="product__badge is-out">OUT OF STOCK</span>';
        } else if (promoBadge) {
          badgeHtml =
            '<span class="product__badge ' +
            (promoBadge === "NEW" ? "is-new" : "") +
            '">' +
            promoBadge +
            "</span>";
        }
        const spiceHtml = spice ? '<span class="product__spice">' + spice + "</span>" : "";
        const addHtml = soldOut
          ? '<span class="product__add btn is-disabled" aria-disabled="true">Out of stock</span>'
          : '<a class="product__add btn" href="' +
            orderUrl +
            '"><svg class="icon" viewBox="0 0 24 24" width="16" height="16">' +
            '<path d="M12 5v14M5 12h14"/></svg>Add to cart</a>';
        return (
          '<article class="product' + (soldOut ? " is-out" : "") + '">' +
          '<div class="product__img" style="--h:' +
          hue +
          ';position:relative;overflow:hidden;aspect-ratio:16/10">' +
          badgeHtml +
          '<img class="product__photo" src="' +
          esc(photoFor(m, i)) +
          '" alt="' +
          esc(m.name) +
          '" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" /></div>' +
          '<div class="product__body"><div class="product__head">' +
          '<h3 class="product__name">' +
          esc(m.name) +
          '</h3><span class="product__price">₹' +
          esc(m.price) +
          "</span></div>" +
          '<p class="product__desc">' +
          esc(m.description) +
          '</p><div class="product__meta">' +
          '<span class="product__serves">' +
          esc(m.serves) +
          "</span>" +
          spiceHtml +
          "</div></div>" +
          addHtml +
          "</article>"
        );
      }
      fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: QUERY }),
      })
        .then((r) => r.json())
        .then((res) => {
          const items = (res && res.data && res.data.menuItems) || [];
          if (!items.length) {
            grid.innerHTML =
              '<p class="menu-empty">Our menu is being updated — please check back shortly.</p>';
            return;
          }
          grid.innerHTML = items.map(card).join("");
        })
        .catch(() => {
          grid.innerHTML =
            '<p class="menu-empty">Couldn\'t load the menu — please refresh.</p>';
        });

      // Store status + maintenance mode (admin-managed settings)
      const SETTINGS_QUERY =
        "query { settings { storeOpenNow storeOpenTime storeCloseTime maintenance { website } } }";
      fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: SETTINGS_QUERY }),
      })
        .then((r) => r.json())
        .then((res) => {
          const s = res && res.data && res.data.settings;
          if (!s) return;
          if (s.maintenance && s.maintenance.website) {
            const overlay = document.createElement("div");
            overlay.className = "maint-overlay";
            overlay.innerHTML =
              '<div class="maint-card"><div class="maint-emoji">🛠️</div>' +
              "<h2>Back in a bit!</h2>" +
              "<p>We're doing a little maintenance. The biryani isn't going anywhere — check back soon.</p></div>";
            document.body.appendChild(overlay);
            document.body.style.overflow = "hidden";
            return;
          }
          const status = document.getElementById("store-status");
          if (status) {
            status.hidden = false;
            if (s.storeOpenNow) {
              status.textContent = "● Open now · " + s.storeOpenTime + "–" + s.storeCloseTime;
              status.classList.add("is-open");
            } else {
              status.textContent = "● Closed · opens " + s.storeOpenTime;
              status.classList.add("is-closed");
            }
          }
        })
        .catch(() => undefined);
    })();
  </script>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">How it works</p>
        <h2 class="section-title">
          From craving to <span class="italic-accent">first bite</span><br />in three taps.
        </h2>
      </div>

      <div class="steps-grid">
        {
          steps.map((s) => (
            <div class="step card reveal">
              <span class="step__n">{s.n}</span>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ STORY ============ -->
  <section class="story" id="story">
    <div class="container story__inner">
      <div class="story__visual reveal">
        <div class="story__photo">
          <img
            src="/biryani-3.jpg"
            alt="Steaming veg dum biryani fresh from the handi, layered with rice and spices"
            width="220"
            height="150"
            loading="lazy"
          />
          <span class="story__photo-tag">Didi &amp; Bhaiya</span>
        </div>
      </div>

      <div class="story__copy reveal">
        <p class="eyebrow">Our story</p>
        <h2 class="section-title story__title">
          Two siblings,<br />one big handi of love.
        </h2>
        <p class="story__text">
          It started in a tiny home kitchen — Didi on the masala, Bhaiya on the
          dum. One pot of biryani for the whole gali, and a promise: every plate
          should be the kind you remember.
        </p>
        <p class="story__script">Har bite, yaad rahe.</p>
        <a href="/#story" class="btn btn-maroon">
          Read our story
          <svg class="icon" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ PARTY ============ -->
  <section class="section" id="party">
    <div class="container">
      <div class="party reveal">
        <div class="party__copy">
          <p class="eyebrow eyebrow--light">Party &amp; bulk orders</p>
          <h2 class="party__title">Feeding a crowd? We've got the handi for it.</h2>
          <p class="party__text">
            Birthdays, office lunches, pujas and big fat dawats — order in bulk
            with dedicated catering support and special per-plate pricing.
          </p>
          <button type="button" class="btn btn-gold" id="party-open" aria-expanded="false" aria-controls="party-form">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18"><path d="M12 5v14M5 12h14"/></svg>
            Plan a Party Order
          </button>

          <form class="party-form" id="party-form" hidden>
            <div class="party-form__row">
              <input id="po-name" type="text" placeholder="Your name*" autocomplete="name" />
              <input id="po-phone" type="tel" placeholder="Phone*" autocomplete="tel" />
            </div>
            <input id="po-email" type="email" placeholder="Email*" autocomplete="email" />
            <div class="party-form__row">
              <input id="po-date" type="text" placeholder="Event date (e.g. 15 Aug)" />
              <input id="po-guests" type="number" min="1" placeholder="Guests" />
            </div>
            <input id="po-location" type="text" placeholder="Location / society" />
            <textarea id="po-message" rows="2" placeholder="Menu, budget, timing — tell us about your party"></textarea>
            <div class="party-form__captcha">
              <label id="po-captcha-q" for="po-captcha-a">Captcha: …</label>
              <input id="po-captcha-a" inputmode="numeric" placeholder="Answer*" />
            </div>
            <p class="party-form__msg" id="po-msg" hidden></p>
            <button type="submit" class="btn btn-gold" id="po-submit">Send request</button>
          </form>
        </div>
        <ul class="party__perks">
          {
            partyPerks.map((p) => (
              <li class="party__perk">
                <span class="party__perk-icon"><Fragment set:html={iconSvg(p.icon)} /></span>
                <span>
                  <strong>{p.title}</strong>
                  <small>{p.text}</small>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    (function () {
      const openBtn = document.getElementById("party-open");
      const form = document.getElementById("party-form");
      if (!openBtn || !form) return;
      const qEl = document.getElementById("po-captcha-q");
      const answerEl = document.getElementById("po-captcha-a");
      const msg = document.getElementById("po-msg");
      const submitBtn = document.getElementById("po-submit");
      let captchaId = null;

      function gql(query, variables) {
        return fetch(apiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query, variables }),
        }).then((r) => r.json());
      }
      function loadCaptcha() {
        captchaId = null;
        qEl.textContent = "Captcha: …";
        gql("query { captcha { id question } }")
          .then((res) => {
            const c = res && res.data && res.data.captcha;
            if (c) {
              captchaId = c.id;
              qEl.textContent = "Captcha: " + c.question;
            } else {
              qEl.textContent = "Captcha unavailable — please refresh.";
            }
          })
          .catch(() => {
            qEl.textContent = "Captcha unavailable — please refresh.";
          });
      }
      function showMsg(text, ok) {
        msg.hidden = false;
        msg.textContent = text;
        msg.style.color = ok ? "#5fb45f" : "#e0584b";
      }
      function val(id) {
        return document.getElementById(id).value.trim();
      }

      openBtn.addEventListener("click", function () {
        const willShow = form.hidden;
        form.hidden = !willShow;
        openBtn.setAttribute("aria-expanded", String(willShow));
        if (willShow && !captchaId) loadCaptcha();
      });

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const name = val("po-name");
        const phone = val("po-phone");
        const email = val("po-email");
        const answer = val("po-captcha-a");
        if (!name || !phone || !email) {
          showMsg("Name, phone and email are required.", false);
          return;
        }
        if (!captchaId || !answer) {
          showMsg("Please solve the captcha.", false);
          return;
        }
        const guestsRaw = val("po-guests");
        const input = {
          name: name,
          phone: phone,
          email: email,
          eventDate: val("po-date") || null,
          guests: guestsRaw ? Number.parseInt(guestsRaw, 10) : null,
          location: val("po-location") || null,
          message: val("po-message") || null,
        };
        submitBtn.disabled = true;
        showMsg("Sending…", true);
        const MUT =
          "mutation($input: PartyOrderInput!, $id: String!, $a: String!) { submitPartyOrder(input: $input, captchaId: $id, captchaAnswer: $a) }";
        gql(MUT, { input: input, id: captchaId, a: answer })
          .then((res) => {
            submitBtn.disabled = false;
            if (res.errors && res.errors.length) {
              showMsg(res.errors[0].message, false);
              answerEl.value = "";
              loadCaptcha();
              return;
            }
            form.reset();
            loadCaptcha();
            showMsg("Thanks! Our catering team will reach out shortly. 🎉", true);
          })
          .catch(() => {
            submitBtn.disabled = false;
            showMsg("Couldn't send — please try again.", false);
          });
      });
    })();
  </script>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section section--alt">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">Loved by the city</p>
        <h2 class="section-title">
          500 ratings can't be <span class="italic-accent">wrong.</span>
        </h2>
      </div>

      <div class="reviews-grid">
        {
          reviews.map((r) => (
            <figure class="review card reveal">
              <div class="review__stars">★★★★★</div>
              <blockquote class="review__text">“{r.text}”</blockquote>
              <figcaption class="review__author">
                <span class="review__avatar">{r.name.charAt(0)}</span>
                <span>
                  <strong>{r.name}</strong>
                  <small>{r.meta}</small>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ APP ============ -->
  <section class="section" id="app">
    <div class="container app-section">
      <div class="app-copy reveal">
        <p class="eyebrow">Get the app</p>
        <h2 class="section-title">Order faster. Earn rewards. Track live.</h2>
        <p class="app-text">
          Save your favourites, reorder in one tap, unlock app-only offers and
          watch your handi arrive — all from the Didi Bhaiya ki Biryani app.
        </p>
        <AppBadges />
      </div>

      <div class="app-visual reveal">
        <div class="phone">
          <div class="phone__notch"></div>
          <div class="phone__screen">
            <div class="phone__bar">BIRYANI <span>🔔</span></div>
            <div class="phone__card">
              <div class="phone__thumb"></div>
              <div class="phone__row">
                <span>Hyderabadi Veg Dum</span>
                <b>₹249</b>
              </div>
              <button class="phone__add">Add</button>
            </div>
            <div class="phone__card">
              <div class="phone__thumb phone__thumb--2"></div>
              <div class="phone__row">
                <span>Paneer Tikka Biryani</span>
                <b>₹289</b>
              </div>
              <button class="phone__add">Add</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="section">
    <div class="container">
      <div class="final-cta reveal">
        <p class="final-cta__script">Hungry yet?</p>
        <h2 class="final-cta__title">
          Your next favourite biryani<br />is 35 minutes away.
        </h2>
        <div class="final-cta__btns">
          <a href={ORDER_URL} class="btn btn-gold">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
              <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
            </svg>
            Order Now
          </a>
          <a href="/offers" class="btn btn-ghost">Order today's offers</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-sub {
    color: var(--text-muted);
    max-width: 560px;
    margin: 16px auto 0;
    font-size: 1rem;
  }
  .section--alt {
    background: var(--bg-soft);
    border-block: 1px solid var(--card-border);
  }

  /* Features */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-top: 48px;
  }
  .feature { padding: 26px 22px; }
  .feature__icon {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(228, 182, 92, 0.10);
    color: var(--gold);
    margin-bottom: 16px;
  }
  .feature__icon :global(svg) { width: 22px; height: 22px; }
  .feature__title { font-size: 1.1rem; margin-bottom: 8px; }
  .feature__text { color: var(--text-muted); font-size: 0.9rem; }

  /* Menu */
  .menu-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
  }
  .menu-head .section-title { margin-top: 10px; }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--gold);
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .link-arrow:hover { gap: 12px; }
  .menu-empty {
    color: var(--text-muted);
    text-align: center;
    padding: 32px 0;
  }
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  /* Steps */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 48px;
  }
  .step {
    padding: 28px 24px;
    position: relative;
  }
  .step__n {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--gold);
    background: rgba(228, 182, 92, 0.10);
    border: 1px solid var(--card-border-strong);
    padding: 4px 12px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 18px;
  }
  .step__title { font-size: 1.15rem; margin-bottom: 10px; }
  .step__text { color: var(--text-muted); font-size: 0.92rem; }

  /* Story */
  .story {
    background: linear-gradient(180deg, #f4ead9, #efe2cc);
    color: #2a1c10;
    padding-block: 70px;
  }
  .story__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }
  .story__photo {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 30px 60px -25px rgba(60, 30, 10, 0.5);
    background: #3a1410;
  }
  .story__photo svg,
  .story__photo img { width: 100%; height: auto; display: block; object-fit: cover; }
  .story__photo-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(8, 5, 3, 0.7);
    color: #f3d9a6;
    font-family: var(--font-script);
    font-size: 1.05rem;
    padding: 4px 14px;
    border-radius: 999px;
  }
  .story__copy .eyebrow { color: var(--gold-deep); }
  .story__title { color: #2a1c10; }
  .story__text {
    color: #5a4634;
    margin-top: 18px;
    font-size: 1.02rem;
    max-width: 460px;
  }
  .story__script {
    font-family: var(--font-script);
    font-size: 1.5rem;
    color: #8a3a24;
    margin: 18px 0 24px;
  }
  .story .btn-maroon {
    background: linear-gradient(180deg, #5a1a1a, #3a1010);
    color: #f5ece0;
  }

  /* Party */
  .party {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
    background:
