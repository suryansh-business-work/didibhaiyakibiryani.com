---
interface Props {
  name: string;
  price: number;
  desc: string;
  serves: string;
  spice?: number; // 0-3 chillies
  badge?: "BESTSELLER" | "NEW" | "";
  hue?: number; // tweak placeholder warmth
}
const { name, price, desc, serves, spice = 0, badge = "", hue = 16 } = Astro.props;
---

<article class="product reveal">
  <div class="product__img" style={`--h:${hue}`}>
    {badge && <span class={`product__badge ${badge === "NEW" ? "is-new" : ""}`}>{badge}</span>}
    <svg class="product__bowl" viewBox="0 0 120 90" aria-hidden="true">
      <ellipse cx="60" cy="62" rx="42" ry="20" fill="rgba(0,0,0,0.35)" />
      <path d="M22 50a38 16 0 0 0 76 0Z" fill="#3a1410" />
      <ellipse cx="60" cy="50" rx="38" ry="15" fill="#5e2218" />
      <g fill="#f0e3c8">
        <ellipse cx="48" cy="45" rx="3.4" ry="1.5" transform="rotate(-20 48 45)" />
        <ellipse cx="60" cy="42" rx="3.4" ry="1.5" transform="rotate(15 60 42)" />
        <ellipse cx="72" cy="46" rx="3.4" ry="1.5" transform="rotate(-12 72 46)" />
        <ellipse cx="54" cy="50" rx="3.4" ry="1.5" transform="rotate(28 54 50)" />
        <ellipse cx="66" cy="51" rx="3.4" ry="1.5" transform="rotate(-25 66 51)" />
      </g>
      <circle cx="52" cy="46" r="2" fill="#e4b65c" />
      <circle cx="68" cy="44" r="2" fill="#5fb45f" />
      <circle cx="60" cy="50" r="2" fill="#e4b65c" />
    </svg>
  </div>

  <div class="product__body">
    <div class="product__head">
      <h3 class="product__name">{name}</h3>
      <span class="product__price">₹{price}</span>
    </div>
    <p class="product__desc">{desc}</p>
    <div class="product__meta">
      <span class="product__serves">{serves}</span>
      {
        spice > 0 && (
          <span class="product__spice" aria-label={`Spice level ${spice} of 3`}>
            {Array.from({ length: spice }).map(() => "🌶️").join("")}
          </span>
        )
      }
    </div>
  </div>

  <button class="product__add btn" type="button">
    <svg class="icon" viewBox="0 0 24 24" width="16" height="16"><path d="M12 5v14M5 12h14" /></svg>
    Add to cart
  </button>
</article>

<style>
  .product {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .product:hover {
    transform: translateY(-4px);
    border-color: var(--card-border-strong);
    box-shadow: var(--shadow-soft);
  }
  .product__img {
    position: relative;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(120% 90% at 50% 0%, hsla(var(--h), 60%, 28%, 0.55), transparent 60%),
      linear-gradient(180deg, #241712, #14100c);
    display: grid;
    place-items: end center;
    padding-bottom: 6px;
  }
  .product__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: linear-gradient(180deg, #d23b2e, #a82b21);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 9px;
    border-radius: 6px;
    text-transform: uppercase;
  }
  .product__badge.is-new {
    background: linear-gradient(180deg, #f0c768, #d49a3c);
    color: #2a1a06;
  }
  .product__bowl { width: 72%; height: auto; }

  .product__body {
    padding: 16px 16px 12px;
    flex: 1;
  }
  .product__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .product__name {
    font-size: 1.04rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .product__price {
    font-family: var(--font-display);
    color: var(--gold);
    font-weight: 700;
    font-size: 1.05rem;
    white-space: nowrap;
  }
  .product__desc {
    color: var(--text-muted);
    font-size: 0.84rem;
    margin-top: 8px;
    line-height: 1.5;
  }
  .product__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .product__add {
    margin: 0 12px 14px;
    justify-content: center;
    background: rgba(228, 182, 92, 0.10);
    border: 1px solid var(--gold-soft);
    color: var(--gold);
    padding: 11px;
    font-size: 0.9rem;
  }
  .product__add:hover {
    background: var(--gold);
    color: #2a1a06;
    transform: none;
  }
</style>
