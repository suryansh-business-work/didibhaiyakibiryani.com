---
import AppBadges from "./AppBadges.astro";
import { ORDER_URL } from "../lib/api";
---

<footer class="site-footer" id="contact">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-emblem">
        <img
          data-logo="footer"
          src="/didibhaiyakibiryani-logo.png"
          alt="Didi Bhaiya ki Biryani logo"
          width="84"
          height="84"
        />
      </div>
      <p class="footer-tagline">Har bite, yaad rahe.</p>
      <p class="footer-desc">
        100% vegetarian dum biryani, dum-cooked in copper handis and delivered
        piping hot across the city.
      </p>

      <div class="socials">
        <a href="#" aria-label="Instagram" class="social">
          <svg viewBox="0 0 24 24" class="icon" width="18" height="18">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="#" aria-label="Facebook" class="social">
          <svg viewBox="0 0 24 24" class="icon" width="18" height="18">
            <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H7v3h2v9h3v-9h2.5l.5-3H12V6.5a.5.5 0 0 1 .5-.5H15Z" />
          </svg>
        </a>
        <a href="#" aria-label="YouTube" class="social">
          <svg viewBox="0 0 24 24" class="icon" width="18" height="18">
            <rect x="2.5" y="6" width="19" height="12" rx="4" />
            <path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="#" aria-label="WhatsApp" class="social">
          <svg viewBox="0 0 24 24" class="icon" width="18" height="18">
            <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.2-5.2A8.5 8.5 0 1 1 21 11.5Z" />
            <path d="M8.5 9c0 4 2.5 6.5 6.5 6.5M9 9c.4-.9 1.4-1 1.8-.2l.6 1.2c.2.4 0 .8-.3 1 .5 1 .9 1.4 1.9 1.9.2-.3.6-.5 1-.3l1.2.6c.8.4.7 1.4-.2 1.8" />
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer-col" aria-label="Explore">
      <h4>Explore</h4>
      <a href="/#menu">Full Menu</a>
      <a href="/offers">Offers</a>
      <a href="/#party">Party Orders</a>
      <a href={ORDER_URL}>Order Now</a>
    </nav>

    <nav class="footer-col" aria-label="Company">
      <h4>Company</h4>
      <a href="/#story">Our Story</a>
      <a href="/#faq">FAQ</a>
      <a href="/#contact">Contact</a>
      <a href="/#app">Get the App</a>
      <p class="footer-hours" data-setting-row hidden>
        <span data-setting="companyAddress"></span>
      </p>
      <p class="footer-hours" data-setting-row hidden>
        <a href="/" data-setting="companyPhone"></a>
      </p>
      <p class="footer-hours" data-setting-row hidden>
        <a href="/" data-setting="companyEmail"></a>
      </p>
    </nav>

    <div class="footer-col footer-app">
      <h4>Get the App</h4>
      <AppBadges small />
      <p class="footer-hours">Daily · 11 am – 11 pm</p>
      <p class="footer-hours">Delivery only · No dine-in</p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 Didi Bhaiya ki Biryani (D&B Foods). All rights reserved.</p>
    <p class="footer-cert">
      <span class="dot"></span> 100% PURE VEG KITCHEN · FSSAI CERTIFIED
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: #080503;
    border-top: 1px solid var(--card-border);
    padding-top: 64px;
    margin-top: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 40px;
    padding-bottom: 48px;
  }
  .footer-emblem {
    width: 84px;
    height: 84px;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .footer-emblem svg,
  .footer-emblem img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .footer-tagline {
    font-family: var(--font-script);
    font-size: 1.35rem;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .footer-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    max-width: 320px;
    margin-bottom: 22px;
  }
  .socials { display: flex; gap: 12px; }
  .social {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    border: 1px solid var(--card-border);
    transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }
  .social:hover {
    color: var(--gold);
    border-color: var(--gold-soft);
    transform: translateY(-2px);
  }

  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--gold);
    margin-bottom: 18px;
  }
  .footer-col a {
    display: block;
    color: var(--text-muted);
    font-size: 0.94rem;
    padding: 6px 0;
    transition: color 0.18s ease;
  }
  .footer-col a:hover { color: var(--text); }
  .footer-hours {
    color: var(--text-muted);
    font-size: 0.86rem;
    margin-top: 8px;
  }
  .footer-app :global(.app-badges) { margin-bottom: 14px; }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px;
    border-top: 1px solid var(--card-border);
    font-size: 0.82rem;
    color: var(--text-faint);
  }
  .footer-cert {
    color: var(--green);
    font-weight: 700;
    letter-spacing: 0.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .footer-cert .dot {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    background: var(--green);
  }

  @media (max-width: 920px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
