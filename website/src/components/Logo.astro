---
interface Props {
  size?: number;
  stacked?: boolean;
}
const { size = 56, stacked = false } = Astro.props;
---

<a href="/" class={`logo ${stacked ? "logo--stacked" : ""}`} aria-label="Didi Bhaiya ki Biryani — home">
  <span class="logo__badge" style={`--s:${size}px`}>
    <img
      class="logo__img"
      data-logo="header"
      src="/didibhaiyakibiryani-logo.png"
      alt="Didi Bhaiya ki Biryani logo"
      width={size}
      height={size}
      loading="eager"
    />
  </span>
  <span class="logo__text">
    <span class="logo__script">Didi Bhaiya ki</span>
    <span class="logo__name">BIRYANI</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .logo__badge {
    width: var(--s);
    height: var(--s);
    flex: 0 0 auto;
    border-radius: 50%;
    overflow: hidden;
    display: block;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.6);
  }
  .logo__badge svg,
  .logo__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__script {
    font-family: var(--font-script);
    font-size: 0.92rem;
    color: var(--gold);
    margin-bottom: 1px;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.18rem;
    letter-spacing: 1.5px;
    color: var(--text);
  }
  .logo--stacked .logo__text {
    align-items: flex-start;
  }
</style>
