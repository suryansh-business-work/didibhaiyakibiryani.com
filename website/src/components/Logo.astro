---
interface Props {
  size?: number;
  stacked?: boolean;
}
const { size = 56, stacked = false } = Astro.props;
---

<a href="/" class={`logo ${stacked ? "logo--stacked" : ""}`} aria-label="Didi Bhaiya ki Biryani — home">
  <span class="logo__badge" style={`--s:${size}px`}>
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <radialGradient id="lg-bowl" cx="50%" cy="38%" r="70%">
          <stop offset="0%" stop-color="#7a2418" />
          <stop offset="100%" stop-color="#3a0f0c" />
        </radialGradient>
      </defs>
      <circle cx="50" cy="50" r="48" fill="#120a07" stroke="#e4b65c" stroke-width="2.5" />
      <circle cx="50" cy="50" r="40" fill="url(#lg-bowl)" />
      <!-- rice grains -->
      <g fill="#f3e7cf">
        <ellipse cx="42" cy="40" rx="2.4" ry="1.1" transform="rotate(-25 42 40)" />
        <ellipse cx="52" cy="36" rx="2.4" ry="1.1" transform="rotate(20 52 36)" />
        <ellipse cx="60" cy="42" rx="2.4" ry="1.1" transform="rotate(-15 60 42)" />
        <ellipse cx="46" cy="48" rx="2.4" ry="1.1" transform="rotate(35 46 48)" />
        <ellipse cx="56" cy="50" rx="2.4" ry="1.1" transform="rotate(-30 56 50)" />
        <ellipse cx="38" cy="50" rx="2.4" ry="1.1" transform="rotate(10 38 50)" />
        <ellipse cx="64" cy="52" rx="2.4" ry="1.1" transform="rotate(28 64 52)" />
        <ellipse cx="50" cy="58" rx="2.4" ry="1.1" transform="rotate(-12 50 58)" />
      </g>
      <!-- saffron / mint dots -->
      <circle cx="44" cy="44" r="2" fill="#e4b65c" />
      <circle cx="58" cy="46" r="2" fill="#5fb45f" />
      <circle cx="50" cy="52" r="2" fill="#e4b65c" />
    </svg>
  </span>
  <span class="logo__text">
    <span class="logo__script">Didi Bhaiya ki</span>
    <span class="logo__name">BIRYANI</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .logo__badge {
    width: var(--s);
    height: var(--s);
    flex: 0 0 auto;
    border-radius: 50%;
    overflow: hidden;
    display: block;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.6);
  }
  .logo__badge svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__script {
    font-family: var(--font-script);
    font-size: 0.92rem;
    color: var(--gold);
    margin-bottom: 1px;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.18rem;
    letter-spacing: 1.5px;
    color: var(--text);
  }
  .logo--stacked .logo__text {
    align-items: flex-start;
  }
</style>
