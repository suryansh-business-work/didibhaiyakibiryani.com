---
---

<section class="hero">
  <div class="hero__glow"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__script">Har bite, yaad rahe!</p>
      <h1 class="hero__title">
        Didi Bhaiya <span class="italic-accent">ki</span><br />
        Biryani.
      </h1>
      <p class="hero__lede">
        100% vegetarian biryani, slow dum-cooked in copper handis with
        hand-ground spice — and delivered to your door piping hot.
      </p>

      <div class="hero__cta">
        <a href="/offers" class="btn btn-gold">
          <svg class="icon" viewBox="0 0 24 24" width="18" height="18">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
            <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
          </svg>
          Order Now
        </a>
        <a href="/#menu" class="btn btn-ghost">View Full Menu</a>
      </div>

      <div class="hero__stats">
        <div class="stat">
          <span class="stat__num">4.8<span class="stat__star">★</span></span>
          <span class="stat__label">12,400+ ratings</span>
        </div>
        <span class="stat__div"></span>
        <div class="stat">
          <span class="stat__num">35 min</span>
          <span class="stat__label">avg delivery</span>
        </div>
        <span class="stat__div"></span>
        <div class="stat">
          <span class="stat__num">100%</span>
          <span class="stat__label">pure-veg</span>
        </div>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__card">
        <span class="hero__veg">
          <span class="veg-dot"></span> Veg Only
        </span>

        <div class="hero__plate">
          <svg viewBox="0 0 320 280" aria-hidden="true" class="hero__plate-svg">
            <defs>
              <radialGradient id="plate" cx="50%" cy="40%" r="65%">
                <stop offset="0%" stop-color="#8a2a18" />
                <stop offset="100%" stop-color="#3a0f0c" />
              </radialGradient>
            </defs>
            <ellipse cx="160" cy="180" rx="135" ry="70" fill="rgba(0,0,0,0.4)" />
            <ellipse cx="160" cy="160" rx="135" ry="72" fill="#1c100b" />
            <ellipse cx="160" cy="150" rx="118" ry="62" fill="url(#plate)" />
            <g fill="#f1e4c9">
              <!-- scattered rice grains -->
              <ellipse cx="120" cy="135" rx="5" ry="2.2" transform="rotate(-22 120 135)" />
              <ellipse cx="150" cy="125" rx="5" ry="2.2" transform="rotate(18 150 125)" />
              <ellipse cx="185" cy="132" rx="5" ry="2.2" transform="rotate(-14 185 132)" />
              <ellipse cx="135" cy="150" rx="5" ry="2.2" transform="rotate(30 135 150)" />
              <ellipse cx="170" cy="148" rx="5" ry="2.2" transform="rotate(-28 170 148)" />
              <ellipse cx="205" cy="145" rx="5" ry="2.2" transform="rotate(12 205 145)" />
              <ellipse cx="110" cy="158" rx="5" ry="2.2" transform="rotate(8 110 158)" />
              <ellipse cx="160" cy="165" rx="5" ry="2.2" transform="rotate(-18 160 165)" />
              <ellipse cx="195" cy="162" rx="5" ry="2.2" transform="rotate(24 195 162)" />
              <ellipse cx="142" cy="172" rx="5" ry="2.2" transform="rotate(-10 142 172)" />
            </g>
            <!-- saffron strands & mint & cashews -->
            <circle cx="128" cy="140" r="3.4" fill="#e4b65c" />
            <circle cx="178" cy="138" r="3.4" fill="#5fb45f" />
            <circle cx="158" cy="155" r="3.4" fill="#e4b65c" />
            <circle cx="198" cy="150" r="3" fill="#c9772f" />
            <circle cx="118" cy="150" r="3" fill="#5fb45f" />
            <!-- steam -->
            <path class="steam s1" d="M120 95c-8-12 8-18 0-30" />
            <path class="steam s2" d="M160 88c-8-12 8-18 0-30" />
            <path class="steam s3" d="M200 95c-8-12 8-18 0-30" />
          </svg>
        </div>

        <div class="hero__wordmark">
          <span class="hero__wordmark-script">Didi Bhaiya ki</span>
          <span class="hero__wordmark-name">BIRYANI</span>
          <span class="hero__wordmark-tag">★ VEG ONLY ★ D&amp;B</span>
        </div>

        <span class="hero__hot">
          <svg class="icon" viewBox="0 0 24 24" width="15" height="15">
            <path d="M12 2s4 4 4 8a4 4 0 0 1-8 0c0-2 1-3 1-3s-3 2-3 6a6 6 0 0 0 12 0c0-5-6-11-6-11Z" />
          </svg>
          Served piping hot
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(80% 60% at 18% 0%, rgba(74, 21, 21, 0.55), transparent 60%),
      var(--bg);
  }
  .hero__glow {
    position: absolute;
    top: -160px;
    right: -120px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(228, 182, 92, 0.16), transparent 65%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    padding-block: 70px 84px;
  }
  .hero__script {
    font-family: var(--font-script);
    font-size: 1.6rem;
    color: var(--gold);
    margin-bottom: 6px;
  }
  .hero__title {
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.5px;
  }
  .hero__lede {
    color: var(--text-dim);
    font-size: 1.04rem;
    max-width: 460px;
    margin-top: 20px;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .hero__stats {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 38px;
  }
  .stat { display: flex; flex-direction: column; }
  .stat__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }
  .stat__star { color: var(--gold); font-size: 1rem; }
  .stat__label {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .stat__div {
    width: 1px;
    height: 34px;
    background: var(--card-border-strong);
  }

  /* ---- Visual ---- */
  .hero__visual { display: flex; justify-content: center; }
  .hero__card {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4 / 4.4;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(90% 70% at 50% 25%, #6e2418, #2a0e0b 75%),
      #2a0e0b;
    border: 1px solid var(--card-border-strong);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 28px;
  }
  .hero__card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 40% at 50% 100%, rgba(0, 0, 0, 0.45), transparent);
    pointer-events: none;
  }
  .hero__veg {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    background: rgba(8, 5, 3, 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(95, 180, 95, 0.5);
    color: #cfeccf;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 5px 11px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .veg-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 2px rgba(95, 180, 95, 0.3);
  }
  .hero__plate { width: 92%; }
  .hero__plate-svg { width: 100%; height: auto; }
  .steam {
    fill: none;
    stroke: rgba(255, 240, 220, 0.4);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0;
    animation: steam 3.2s ease-in-out infinite;
  }
  .steam.s2 { animation-delay: 0.6s; }
  .steam.s3 { animation-delay: 1.2s; }
  @keyframes steam {
    0% { opacity: 0; transform: translateY(6px); }
    40% { opacity: 0.7; }
    100% { opacity: 0; transform: translateY(-10px); }
  }

  .hero__wordmark {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 4px;
  }
  .hero__wordmark-script {
    font-family: var(--font-script);
    font-size: 1.3rem;
    color: #f3d9a6;
  }
  .hero__wordmark-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.1rem;
    letter-spacing: 2px;
    color: var(--gold);
    line-height: 1;
  }
  .hero__wordmark-tag {
    font-size: 0.62rem;
    letter-spacing: 2px;
    font-weight: 800;
    color: #f3d9a6;
    background: rgba(0, 0, 0, 0.35);
    padding: 3px 10px;
    border-radius: 999px;
    margin-top: 8px;
  }
  .hero__hot {
    position: absolute;
    bottom: 16px;
    right: 16px;
    z-index: 2;
    background: rgba(8, 5, 3, 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid var(--card-border-strong);
    color: var(--gold);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  @media (max-width: 920px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-block: 48px 60px;
    }
    .hero__visual { order: -1; }
    .hero__card { max-width: 360px; }
    .hero__lede { max-width: none; }
  }
  @media (max-width: 480px) {
    .hero__stats { gap: 14px; }
    .stat__num { font-size: 1.25rem; }
  }
</style>
