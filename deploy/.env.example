# Runtime environment for docker-compose on the production host.
# The deploy workflow writes the real /opt/ddb/.env from GitHub Actions secrets.
# Never commit a filled-in .env — it is gitignored.

# ── Docker Hub (image registry) ──────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username

# ── Database & auth (server) ─────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/ddb?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Browser origins allowed to call the GraphQL API
CORS_ORIGINS=https://didibhaiyakibiryani.com,https://admin.didibhaiyakibiryani.com,https://native.didibhaiyakibiryani.com

# ── SMTP (transactional email) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── ImageKit (media) ─────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINTS=
