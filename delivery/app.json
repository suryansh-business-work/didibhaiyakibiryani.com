{
  "expo": {
    "name": "DDB Delivery Partner",
    "slug": "ddb-delivery",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "ddbdelivery",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0b0705",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.didibhaiya.biryani.delivery"
    },
    "android": {
      "package": "com.didibhaiya.biryani.delivery",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0b0705"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Didi Bhaiya Delivery uses your location to show your live position on the map and guide you to delivery destinations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3001/graphql"
    }
  }
}
