# ── MongoDB Atlas ──────────────────────────────────────────────
# Paste your Atlas connection string here, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ddb?retryWrites=true&w=majority
MONGODB_URI=

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ── Server ─────────────────────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# ── Seed admin (used by `npm run seed`) ────────────────────────
SEED_ADMIN_EMAIL=admin@didibhaiyakibiryani.com
SEED_ADMIN_PASSWORD=Admin@123
