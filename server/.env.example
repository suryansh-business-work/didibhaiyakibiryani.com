# ── MongoDB Atlas ──────────────────────────────────────────────
# Paste your Atlas connection string here, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ddb?retryWrites=true&w=majority
MONGODB_URI=

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ── Server ─────────────────────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3006,http://localhost:3007

# ── Public base URLs (survey / track / receipt / order / admin links) ──
# Optional. Leave blank to auto-pick by NODE_ENV: localhost in dev, the
# production domains when NODE_ENV=production. Set only to override a specific
# environment (e.g. a staging domain).
# SURVEY_PUBLIC_URL=
# TRACK_PUBLIC_URL=
# SERVER_PUBLIC_URL=
# PUBLIC_ORDER_URL=
# PUBLIC_ADMIN_URL=

# ── Seed admin (used by `npm run seed`) ────────────────────────
SEED_ADMIN_EMAIL=admin@didibhaiyakibiryani.com
SEED_ADMIN_PASSWORD=Admin@123

# ── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@didibhaiyakibiryani.com
MAIL_FROM_NAME=Didi Bhaiya ki Biryani

# ── ImageKit (media CDN) — also settable from admin → Integrations (DB wins) ──
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINTS=

# ── Payments (Razorpay) — KEY_ID is public, SECRET/WEBHOOK are server-only ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google Maps (server: geocoding / distance matrix) ──────────
GOOGLE_MAPS_API_KEY=

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Observability (Signoz / OpenTelemetry) ─────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317
OTEL_SERVICE_NAME=ddb-server
OTEL_RESOURCE_ATTRIBUTES=service.namespace=ddb,deployment.environment=production
