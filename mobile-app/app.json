{
  "expo": {
    "name": "Didi Bhaiya ki Biryani",
    "slug": "didi-bhaiya-ki-biryani",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "ddb",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0b0705",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.didibhaiya.biryani"
    },
    "android": {
      "package": "com.didibhaiya.biryani",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0b0705"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-asset",
      "@react-native-vector-icons/material-design-icons",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3001/graphql"
    }
  }
}
